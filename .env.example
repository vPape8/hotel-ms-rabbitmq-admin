# Copia este archivo como .env y reemplaza los valores de ejemplo.
PORT=8083

# Microsoft Entra ID: mismo registro "hotel-bff-admin" que usan los otros microservicios.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_AUDIENCE=00000000-0000-0000-0000-000000000000
# Por defecto solo usuarios con el app role ADMIN pueden administrar RabbitMQ.
# Pon "false" mientras los app roles no estén asignados en Entra ID.
ENTRA_EXIGIR_ROL=true
ENTRA_ROL_REQUERIDO=ADMIN

# RabbitMQ: AMQP para crear/eliminar y la API de management (puerto 15672) para listar.
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_MANAGEMENT_URL=http://localhost:15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
